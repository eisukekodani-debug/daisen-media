---
import { u } from '../../../lib/url';
import Base from '../../../layouts/Base.astro';

const words = [
  { w: '議会', r: 'ぎかい', d: '町民の選挙で選ばれた議員が集まり、町のことを決める場です。町の予算や条例は、議会が決めます。' },
  { w: '議員定数', r: 'ぎいんていすう', d: '議会の議員の人数です。条例で決めます。大山町はいま16人です。' },
  { w: '定例会', r: 'ていれいかい', d: '毎年、条例で決めた回数だけ開かれる議会です。予算などの大事な議案の多くは、定例会で話し合われます。' },
  { w: '臨時会', r: 'りんじかい', d: '必要なときに、話し合う事がらを決めて開かれる議会です。' },
  { w: '会期', r: 'かいき', d: '定例会や臨時会が開かれている期間です。' },
  { w: '議案', r: 'ぎあん', d: '議会に出され、話し合って決める案です。町長が出すもの（予算や条例など）と、議員が出すものがあります。' },
  { w: '条例', r: 'じょうれい', d: '町が独自に定めるきまりです。議会が決めることで、つくったり、変えたりできます。' },
  { w: '本会議', r: 'ほんかいぎ', d: '議員全員が集まって開く会議です。議案の最後の賛否（採決）は、本会議で行います。' },
  { w: '委員会', r: 'いいんかい', d: '議員が分かれて、議案をくわしく調べる会議です。大山町議会には、総務経済と教育民生の2つの常任委員会があります。' },
  { w: '審査', r: 'しんさ', d: '委員会などで、議案の中身をくわしく調べ、質問や話し合いをすることです。' },
  { w: '一般質問', r: 'いっぱんしつもん', d: '議員が、町の仕事全体について、町長などに質問することです。定例会で行われます。' },
  { w: '討論', r: 'とうろん', d: '採決の前に、議員が、賛成または反対の理由を述べることです。' },
  { w: '採決', r: 'さいけつ', d: '議案に賛成か反対かを、議員が決めることです。ふつうは出席した議員の過半数で決まります。議長は加わらず、賛否が同じ数のときだけ議長が決めます。' },
  { w: '議決', r: 'ぎけつ', d: '採決の結果、議会として決めたことです。案のとおり認めることを「可決」、認めないことを「否決」といいます。' },
  { w: '傍聴', r: 'ぼうちょう', d: '議会の会議を見に行くことです。議会の会議は、原則として公開されています。' },
  { w: '請願・陳情', r: 'せいがん・ちんじょう', d: '町民が、議会に要望を出すことです。請願は、議員の紹介を受けて出します。陳情は、紹介がなくても出せます。' },
];
---
<Base
  title="議会のことば――採決・定例会・委員会など"
  description="議会でよく使われる言葉を、ひとつずつやさしく説明します。公式サイトではありません。"
  article={{ published: '2026-10-07T15:00:00+09:00' }}
>
  <article class="wrap">
    <p class="go"><a href={u('/mame/')}>議会の豆知識</a></p>
    <div class="futasuji"></div>
    <h1 class="title">議会のことば――採決・定例会・委員会など</h1>
    <p class="byline"><span>2026年10月7日</span></p>
    <p class="lead">議会の話には、ふだん使わない言葉がたくさん出てきます。このサイトによく出てくる言葉を、ひとつずつ説明します。</p>

    <dl class="kotoba">
      {words.map((x) => (<div><dt>{x.w}<small>{x.r}</small></dt><dd>{x.d}</dd></div>))}
    </dl>

    <p style="margin-top:20px">署名を集めて町や議会に求める「直接請求」については、<a href={u('/mame/chokusetsu-seikyu/')}>知っておきたい「直接請求」のしくみ</a>で説明しています。</p>

    <details class="fold" open>
      <summary>元の資料</summary>
      <div class="body">
        <ul class="sources">
          <li><span class="kind">法律</span><a href="https://laws.e-gov.go.jp/law/322AC0000000067">地方自治法</a>（第102条 定例会・臨時会、第109条 委員会、第115条 会議の公開、第116条 採決、第124条 請願）</li>
        </ul>
      </div>
    </details>
  </article>
</Base>
