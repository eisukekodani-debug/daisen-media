---
import { u } from '../../../lib/url';
import Base from '../../../layouts/Base.astro';

const items = [
  {
    no: '1', t: '条例をつくる・変える・なくす', law: '第74条',
    sign: '50分の1以上（248人）', to: '町長',
    then: '町長は20日以内に議会を開き、意見を付けて条例案を議会にかけます。決めるのは議会です。',
    note: '地方税や、使用料・手数料などのお金を集める条例は対象外です。',
    now: true,
  },
  {
    no: '2', t: '町の仕事を監査してもらう', law: '第75条',
    sign: '50分の1以上（248人）', to: '監査委員',
    then: '監査委員が監査し、その結果を公表して、議会や町長に報告します。',
  },
  {
    no: '3', t: '議会を解散させる', law: '第76〜79条',
    sign: '3分の1以上（4,120人）', to: '選挙管理委員会',
    then: '住民投票が行われ、過半数が賛成すれば、議会は解散します。',
    note: '町議選の日から1年間は、請求できません。',
  },
  {
    no: '4', t: '議員を辞めさせる（リコール）', law: '第80・83・84条',
    sign: '3分の1以上（4,120人）', to: '選挙管理委員会',
    then: '住民投票が行われ、過半数が賛成すれば、その議員は職を失います。',
    note: '議員になった日から1年間は、請求できません。',
  },
  {
    no: '5', t: '町長を辞めさせる（リコール）', law: '第81・83・84条',
    sign: '3分の1以上（4,120人）', to: '選挙管理委員会',
    then: '住民投票が行われ、過半数が賛成すれば、町長は職を失います。',
    note: '町長になった日から1年間は、請求できません。',
  },
  {
    no: '6', t: '副町長・選挙管理委員・監査委員を辞めさせる', law: '第86〜88条',
    sign: '3分の1以上（4,120人）', to: '町長',
    then: '議会で、議員の3分の2以上が出席し、その4分の3以上が賛成すれば、職を失います。',
    note: '副町長は就任から1年間、選挙管理委員と監査委員は6か月間は、請求できません。',
  },
];
---
<Base
  title="知っておきたい「直接請求」のしくみ――6つの種類"
  description="条例の制定・改廃、監査、議会の解散、議員・町長などの解職。地方自治法が定める直接請求の6つの種類と、大山町で必要な署名の目安を紹介します。公式サイトではありません。"
  article={{ published: '2026-10-07T12:00:00+09:00' }}
>
  <article class="wrap">
    <p class="go"><a href={u('/mame/')}>議会の豆知識</a></p>
    <div class="futasuji"></div>
    <h1 class="title">知っておきたい「直接請求」のしくみ――6つの種類</h1>
    <p class="byline"><span>2026年10月7日</span></p>

    <p class="lead">町民が町の政治に関われるのは、選挙の日だけではありません。選挙と選挙のあいだにも、署名を集めて、町や議会に求めることができる仕組みがあります。地方自治法が定める「直接請求」です。</p>

    <figure class="chart">
      <figcaption class="chart-title">大山町で必要な署名の目安</figcaption>
      <div class="hurdle">
        <div><span class="frac">50分の1以上</span><span class="big">248<small>人</small></span><span class="what">条例の請求・監査の請求</span></div>
        <div><span class="frac">3分の1以上</span><span class="big">4,120<small>人</small></span><span class="what">議会の解散・解職の請求</span></div>
      </div>
      <p class="chart-note">2026年9月1日の選挙人名簿（有権者12,359人）から計算した目安です。正式な数は、請求のたびに選挙管理委員会が示します。</p>
    </figure>

    <h2 class="sec">6つの直接請求</h2>
    <ol class="seikyu">
      {items.map((it) => (
        <li>
          <p class="hd"><span class="no">{it.no}</span><b>{it.t}</b>{it.now && <span class="nowtag">いま大山町で進行中</span>}</p>
          <dl>
            <dt>必要な署名</dt><dd>{it.sign}</dd>
            <dt>請求先</dt><dd>{it.to}</dd>
            <dt>そのあと</dt><dd>{it.then}</dd>
          </dl>
          {it.note && <p class="note">{it.note}</p>}
          <p class="law">地方自治法{it.law}</p>
        </li>
      ))}
    </ol>
    <p>1の「条例をつくる・変える・なくす」請求は、いま大山町で、議員定数を16人から14人にする条例の改正を求めて進んでいます。くわしくは<a href={u('/teisu/')}>第1号「大山町の議員定数」</a>の記事をご覧ください。</p>

    <h2 class="sec">署名のきまり</h2>
    <ul>
      <li>署名できるのは、大山町の選挙人名簿に載っている有権者です。</li>
      <li>正式な署名簿に、ご本人が自筆で書いたものだけが有効です。</li>
      <li>署名を集める期間は、町村では1か月です。</li>
      <li>集まった署名は選挙管理委員会が審査し、署名簿は誰でも見られるように公開されます（縦覧）。</li>
    </ul>

    <section class="katsudo">
      <b>一人でもできること</b>
      <ul style="margin:6px 0 0;padding-left:1.2em">
        <li><strong>陳情</strong>：議会への要望を、文書で出せます。どう扱うかは議会が決めます。</li>
        <li><strong>請願</strong>：議員の紹介があれば、議会に請願書を出せます（地方自治法第124条）。</li>
        <li><strong>住民監査請求</strong>：町のお金の使い方が違法・不当だと考えるとき、町民一人でも、監査委員に監査を求められます（地方自治法第242条）。</li>
      </ul>
    </section>

    <details class="fold" open>
      <summary>元の資料</summary>
      <div class="body">
        <ul class="sources">
          <li><span class="kind">法律</span><a href="https://laws.e-gov.go.jp/law/322AC0000000067">地方自治法</a>（第74〜88条、第124条、第242条）</li>
        </ul>
        <p class="note">有権者数は、2026年9月1日の大山町の選挙人名簿によります。</p>
      </div>
    </details>
  </article>
</Base>
