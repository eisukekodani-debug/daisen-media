---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config/site';
import HBar from '../../components/HBar.astro';
import Seats from '../../components/Seats.astro';
import Flow from '../../components/Flow.astro';

const kennai = [
  ['湯梨浜町', '15,983', '77.9', '12', '2025年 13人／12', '―（2013年から12人）'],
  ['琴浦町', '15,236', '140.0', '16', '2026年 20人／16', '―'],
  ['八頭町', '15,092', '206.7', '14', '2025年 無投票', '2016年 16→14'],
  ['大山町', '14,368', '189.8', '16', '2025年 17人／16', '―（2013年から16人）'],
  ['北栄町', '13,820', '56.9', '13', '2025年 無投票', '2024年 15→13'],
  ['岩美町', '10,415', '122.3', '12', '2026年 13人／12', '―（2006年から12人）'],
  ['伯耆町', '10,063', '139.4', '13', '2025年 無投票', '2024年 14→13'],
  ['南部町', '9,781', '114.0', '14', '2024年 無投票', '―'],
  ['智頭町', '5,822', '224.7', '10', '2025年 11人／10', '2023年 12→10'],
  ['三朝町', '5,533', '233.5', '10', '2025年 12人／10', '2024年 12→10'],
  ['日南町', '3,673', '341.0', '10', '2023年 無投票', '2017年 12→10'],
  ['日吉津村', '3,575', '4.2', '10', '2023年 無投票', '―'],
  ['若桜町', '2,542', '199.2', '8', '2026年 11人／8', '2023年 10→8'],
  ['日野町', '2,511', '134.0', '10', '2023年 11人／10', '―'],
  ['江府町', '2,394', '124.5', '9', '2025年 10人／9', '2025年 10→9'],
];
---
<Base
  title="大山町の議員定数　16人・14人・もっと少なく――3つの考え方"
  ogImage="/ogp-teisu.png"
  article={{ published: '2026-10-13T09:00:00+09:00' }}
  description="鳥取県大山町議会の議員定数（いまは16人）について、16人を維持する・14人にする・もっと少なくする、の3つの考え方を同じ重さで整理しました。議員定数を14人にする直接請求の手続きも解説します。公式サイトではありません。"
>
  <article class="wrap">
    <p class="go">第1号　2026年10月13日（火）</p>
    <div class="futasuji"></div>
    <h1 class="title">大山町の議員定数　16人・14人・もっと少なく――3つの考え方</h1>
    <p class="byline">
      <span>文・{SITE.operator}｜公開 10月13日（火）</span>
      <button type="button" class="tbtn js-big" style="min-height:40px">文字を大きくする</button>
    </p>

    <div class="kotowari">
      <b>おことわり</b>
      解説では3つの考え方を同じ重さで書き、私の考えは「私はこう見る」の欄にだけ書いています。私は直接請求の代表者ですが、いただいた声は、賛成も反対も同じように受け止めます。
    </div>
    <p class="kakunin">公開前の確認：16人を維持する立場の方に、読んでいただいています（確認中）。</p>

    <section class="card" aria-label="1分でわかる">
      <div class="futasuji"></div>
      <span class="fuda">1分でわかる</span>
      <p class="state"><b>あなたの声を受付中</b></p>
      <ul class="sum">
        <li><span>何が起きる</span>議員の数を16人から14人にする案を、町民の署名で町に求める手続きが始まります</li>
        <li><span>いつから</span>変わるのは次の町議選（2029年4月）から。いまの議員の任期には影響しません</li>
        <li><span>決めるのは</span>署名が集まったあと、町議会が賛否を決めます</li>
      </ul>
      <a class="pbtn" href={SITE.questionFormUrl}>賛成・反対と理由を送る</a>
      <p class="yakusoku">Googleのフォームが開きます。ログインはいりません。名前を書かずに送れます。<a href={u('/rules/')}>お約束と投稿のルール</a></p>
    </section>

    <p class="allopen"><button type="button" class="js-allopen">すべて開く</button></p>

    <details class="fold" open>
      <summary>一言で言うと</summary>
      <div class="body">
        <p>大山町議会の議員の数（定数）は、2013年の町議選から16人のままです。その間に町の人口は約2割減りました。この定数を14人に変える条例の改正を、町民が署名を集めて町に求める「直接請求」が、2026年10月に始まります。</p>
        <p>議員の数に「これが正解」という決まった答えはありません。16人のままがいいという考えにも、14人にという考えにも、もっと少なくという考えにも、それぞれの理由があります。この記事では、その理由を同じ重さで並べます。</p>
        <figure class="chart">
          <figcaption class="chart-title">大山町議会の定数は、2013年から16人のまま</figcaption>
          <div class="timeline4">
            <div><p class="y">2005年<br />合併</p><p class="n">21<small>人</small></p></div>
            <div><p class="y">2009年<br />の町議選から</p><p class="n">19<small>人</small></p></div>
            <div><p class="y">2013年<br />の町議選から</p><p class="n">16<small>人</small></p></div>
            <div><p class="y">2026年<br />いまも</p><p class="n">16<small>人</small></p></div>
          </div>
          <p class="chart-note">出典：大山町議会議員の定数を定める条例と附則（2008年・2012年の改正）</p>
        </figure>
        <figure class="chart">
          <figcaption class="chart-title">その間に、人口は約2割減った</figcaption>
          <p class="chart-lead">次の町議選がある2029年には、2010年から約25%減る見込みです。</p>
          <div class="cols4">
            <div class="c"><span class="v">17,491人</span><span class="bar" style="height:120px"></span><span class="l">2010年<br />（16人に決めたころ）</span></div>
            <div class="c hi"><span class="v">13,969人</span><span class="bar" style="height:96px"></span><span class="l">2025年</span></div>
            <div class="c"><span class="v">13,089人</span><span class="bar" style="height:90px"></span><span class="l">2029年<br />（次の町議選）</span></div>
            <div class="c"><span class="v">12,208人</span><span class="bar" style="height:84px"></span><span class="l">2033年</span></div>
          </div>
          <p class="chart-note">2010年は国勢調査（定数を16人に改めた2012年の条例改正の直前）。2025年以降は国立社会保障・人口問題研究所の推計（2023年推計。年ごとの値は直線で補間）。住民基本台帳の人口は2026年4月1日現在14,368人。</p>
        </figure>
        <h3>数字で見る、いまの大山町議会</h3>
        <table class="data">
          <tbody>
            <tr><th>議員の数</th><td>定数16人（いまは15人。2026年1月に1人が辞職）</td></tr>
            <tr><th>常任委員会</th><td>2つ（総務経済、教育民生）。定数16人なら8人ずつ</td></tr>
            <tr><th>前回の町議選</th><td>2025年4月。定数16に17人が立候補し、落選は1人。投票率70.5%</td></tr>
            <tr><th>議員報酬</th><td>月額23万5千円。期末手当とあわせて、1人あたり年約380万円</td></tr>
          </tbody>
        </table>
        <p class="note">出典：大山町議会議員の定数を定める条例と附則、国勢調査、大山町の住民基本台帳人口、大山町議会「議会の構成」、選挙ドットコム、大山町議会議員の議員報酬及び費用弁償等に関する条例。</p>
      </div>
    </details>

    <details class="fold">
      <summary>直接請求って何？どう進む？</summary>
      <div class="body">
        <p>直接請求は、地方自治法第74条にもとづく町民の権利です。有権者の50分の1以上の署名を集めると、条例の案そのものを、町議会の正式な議題にできます。お願いの文書を出す「陳情」とは違い、町は20日以内に議会を開き、条例案を議会に出さなければなりません。</p>
        <p>大山町議会基本条例の第17条第3項も、議員定数の改正について、町民の直接請求による場合があることを書いています。</p>
        <Flow
          title="直接請求の流れ（日付は予定）"
          steps={[
            { t: '申請と告示', when: '10月13日に申請、19日ごろ告示', d: '請求の代表者が町に申請し、町が証明書を交付して告示します。' },
            { t: '署名集め（1か月）', when: '10月19日ごろ〜11月18日ごろ', d: '有権者の50分の1以上（248人以上）。ご本人が、正式な署名簿に自筆で書きます。' },
            { t: '審査と縦覧', when: '11月下旬〜12月初め', d: '選挙管理委員会が20日以内に署名を審査し、署名簿を7日間、誰でも見られるようにします（縦覧）。' },
            { t: '町へ請求', when: '12月', d: '町は請求の要旨を公表し、20日以内に議会を開いて、意見を付けて条例案を出します。' },
            { t: '議会で審議', when: '12月定例会か1月の臨時会', d: '請求の代表者が、議会で意見を述べることができます（法律で保障されています）。' },
            { t: '議会が決める', d: '可決・否決・修正ができます。結果は公表されます。' },
          ]}
          note="出典：地方自治法第74条・第74条の2、同法施行令第91〜92条。有権者数は2026年9月1日の選挙人名簿（12,359人）から計算。"
        />
        <figure class="chart">
          <figcaption class="chart-title">陳情との違い</figcaption>
          <table class="cmp">
            <thead><tr><th></th><th>陳情</th><th>直接請求</th></tr></thead>
            <tbody>
              <tr><th>議会に出るもの</th><td>要望の文書</td><td class="em">条例案そのもの</td></tr>
              <tr><th>町</th><td>原則関わらない</td><td class="em">20日以内に議会を開く</td></tr>
              <tr><th>町民の発言</th><td>保障はない</td><td class="em">代表者が議会で意見を述べられる</td></tr>
              <tr><th>署名</th><td>決まった手続きはない</td><td class="em">選挙管理委員会が審査・縦覧</td></tr>
            </tbody>
          </table>
        </figure>
        <p>署名に必要な数は、有権者の50分の1以上です。2026年9月1日の選挙人名簿（12,359人）で計算すると248人以上。正式な数は、選挙管理委員会が告示のときに示します。</p>
        <p class="note">署名は、正式な署名簿に、ご本人が自筆で書くものだけが有効です。このサイトでは署名を集めていません。出典：地方自治法第74条・第74条の2、同法施行令第91〜92条、大山町議会基本条例。日付は予定です。</p>
      </div>
    </details>

    <details class="fold" open>
      <summary>3つの考え方</summary>
      <div class="body">
        <p>並べる順番は、数の多い順です。どれが正しいかを示す順ではありません。</p>
        <Seats />
        <div class="stances three">
          <section class="stance">
            <h3>16人を維持する</h3>
            <ul>
              <li>町民の声を幅広く反映するには、今の人数が必要だ。2023年に議会で議論したときも、この点が強調され、現状維持が多数だった</li>
              <li>大山町は189.8km²と広く、2005年に3つの町が合併した。全国の町村を見ると、面積の広い町ほど議員が多い傾向がある</li>
              <li>研究では、議員の数が少ないほど無投票になりやすく、女性議員も増えにくい傾向が示されている</li>
              <li>一度減らすと、増やすのはほとんど不可能に近い</li>
            </ul>
          </section>
          <section class="stance">
            <h3>14人にする</h3>
            <ul>
              <li>16人に決めたころから人口は約2割減った。町民の数に合わせて、議会の形も見直す時期だ</li>
              <li>議案を審査する2つの委員会を、7人ずつ同じ人数で組める。研究者が目安にする「1委員会7〜8人」の範囲に収まる</li>
              <li>人口が同じくらい（1.3万〜1.5万人）の全国の町では、いちばん多い定数は14人</li>
              <li>減らしすぎると、新しく手を挙げる人のハードルが上がる。14人はそこに配慮した数</li>
            </ul>
          </section>
          <section class="stance">
            <h3>もっと少なくする（12人など）</h3>
            <ul>
              <li>研究者は「議論できる人数として6人は下らないのではないだろうか」とも書いている。6人ずつなら12人で2つの委員会を組める</li>
              <li>16人に決めたころから2029年までに、人口は約25%減る見込み。16人の25%減は12人</li>
              <li>面積が同じくらい（180〜220km²）の全国の町では、定数の真ん中は12人。県内でも湯梨浜町と岩美町が12人で議会を運営している</li>
              <li>住民サービスが見直される中で、議会も必要最低限の形にして、自ら見直す姿勢を示すべきだ</li>
            </ul>
          </section>
        </div>
        <h3>データで見る</h3>
        <HBar
          title="議員1人あたりの町民の数"
          caption="14人にすると、2033年の1人あたりの町民は、いまの16人とほぼ同じになります。"
          unit="人"
          items={[
            { label: '2010年', sub: '16人に決めたころ', value: 1093, display: '約1,090' },
            { label: '2025年', sub: '16人', value: 873, display: '約870' },
            { label: '2033年', sub: '16人のまま', value: 763, display: '約760' },
            { label: '2033年', sub: '14人にしたら', value: 872, display: '約870', hi: true },
            { label: '2033年', sub: '12人にしたら', value: 1017, display: '約1,020' },
          ]}
          note="人口は2010年が国勢調査、2025年・2033年は国立社会保障・人口問題研究所の推計（2023年推計）。人口を定数で割って計算。"
        />
        <p class="note">比べるグラフは「県内・全国の町と比べると」にあります。出典：議会だより だいせん74号（2023年11月）、全国町村議会議長会『町村議会議員の議員報酬等のあり方 最終報告』（2019年）、同「第71回町村議会実態調査」（2025年7月1日現在）、国勢調査、国立社会保障・人口問題研究所の将来推計人口（2023年推計）、各町の議員定数条例。</p>
      </div>
    </details>

    <details class="fold">
      <summary>主な論点</summary>
      <div class="body">
        <p class="note">賛成側にも反対側にも、同じ厳しさで確かめます。</p>
        <ol class="kensho">
          <li>
            <b>① 減らせば、選挙は活発になる？</b>
            そうとは言えません。県内では、北栄町（15→13人）と伯耆町（14→13人）が、減らしたあとの2025年の町議選で無投票でした。逆に、若桜町や江府町のように、無投票や定数割れのあとに減らして、選挙になった町もあります。全国の研究も、定数が少ないほど無投票になりやすい傾向を示しています。
            <span class="src">出典：選挙ドットコム、各町の選挙結果、各町の議員定数条例、全国町村議会議長会『最終報告』（2019年）第2章</span>
            <figure class="chart">
              <figcaption class="chart-title">大山町の町議選（定数16人になってから）</figcaption>
              <table class="cmp">
                <thead><tr><th>年</th><th>立候補</th><th>落選</th><th>投票率</th></tr></thead>
                <tbody>
                  <tr><th>2013年</th><td>17人</td><td>1人</td><td>79.3%</td></tr>
                  <tr><th>2017年</th><td>19人</td><td>3人</td><td>75.8%</td></tr>
                  <tr><th>2021年</th><td>20人</td><td>4人</td><td>68.8%</td></tr>
                  <tr><th>2025年</th><td>17人</td><td>1人</td><td>70.5%</td></tr>
                </tbody>
              </table>
              <p class="chart-note">大山町の町議選は町長選と同じ日に行われる（2021年は町長が無投票）。出典：選挙ドットコム</p>
            </figure>
          </li>
          <li>
            <b>② お金はどれだけ変わる？</b>
            議員を2人減らすと、報酬と期末手当で年約760万円です。町の予算全体から見れば小さな額で、財政を立て直す額ではありません。研究でも、議員の数と町の支出の関係ははっきりしていません。
            <span class="src">出典：大山町議会議員の議員報酬及び費用弁償等に関する条例から計算、全国町村議会議長会の資料</span>
          </li>
          <li>
            <b>③ 地域の声は届かなくなる？</b>
            大山町の町議選は、2008年に議会が旧町ごとの選挙区をなくしてから、町全体で1つの選挙区です。今の16人でも、地区ごとの代表は保証されていません。減らせば、議員のいない地区が増える可能性はあります。
            <span class="src">出典：大山町議会議員の定数を定める条例の附則</span>
          </li>
          <li>
            <b>④ 直接請求で、条例は通る？</b>
            全国では、議員定数を減らす直接請求が、請求どおり可決されることはめったにありません（総務省の地方自治月報で、2016年4月から2025年3月までの14件に原案どおりの可決は見当たりません）。ただ、否決のあとに議会が自分で定数を見直した町はあります。福島県川俣町では2015年、町民の直接請求で16人から12人への条例案が可決されました。
            <span class="src">出典：総務省『地方自治月報』、川俣町議会 平成27年第5回臨時会会議録</span>
          </li>
        </ol>
      </div>
    </details>

    <details class="fold" open>
      <summary>県内・全国の町と比べると</summary>
      <div class="body">
        <p>県内の町村で、定数16人は大山町と琴浦町だけです。この10年ほどで、8つの町が定数を見直しました（若桜・智頭・八頭・三朝・北栄・伯耆・日南・江府）。</p>
        <HBar
          title="鳥取県内の町村の定数（人口の多い順）"
          unit="人"
          items={kennai.map((r) => ({ label: r[0], value: Number(r[3]), hi: r[0] === '大山町', sub: `${r[1]}人` }))}
          note="人口は住民基本台帳（2026年4〜5月現在。岩美町は10月1日現在）。定数は各町村の議員定数条例。"
        />
        <HBar
          title="全国の、人口が同じくらいの町の定数"
          caption="人口1.3万〜1.5万人の町は全国に61町。いちばん多い定数は14人（22町）で、真ん中も14人。16人は大山町を含めて9町です。"
          unit="町"
          items={[
            { label: '10人', value: 4 },
            { label: '11人', value: 4 },
            { label: '12人', value: 11 },
            { label: '13人', value: 8 },
            { label: '14人', value: 22 },
            { label: '15人', value: 3 },
            { label: '16人', value: 9, hi: true, sub: '大山町はここ' },
          ]}
          note="住民基本台帳人口13,000人以上15,000人未満の町（村は除く）。大山町は14,599人。"
        />
        <HBar
          title="全国の、面積が同じくらいの町の定数"
          caption="面積180〜220km²の町は全国に45町。真ん中は12人で、いちばん多いのは10人（15町）。16人は大山町と香川県まんのう町の2町だけです。"
          unit="町"
          items={[
            { label: '8人', value: 1 },
            { label: '9人', value: 3 },
            { label: '10人', value: 15 },
            { label: '11人', value: 2 },
            { label: '12人', value: 11 },
            { label: '13人', value: 4 },
            { label: '14人', value: 6 },
            { label: '15人', value: 1 },
