---
import { u } from '../lib/url';
import '../styles/global.css';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  article?: { published: string; modified?: string };
}
const { title, description = SITE.description, noindex = false, ogImage = '/ogp.png', article } = Astro.props;
// 公開日まで検索よけ（PUBLIC_NOINDEX=0 で外す）
const globalNoindex = (import.meta.env.PUBLIC_NOINDEX ?? '1') !== '0';
const ogImageUrl = new URL(u(ogImage), Astro.site).toString();
const siteName = SITE.name;
const homeUrl = new URL(u('/'), Astro.site).toString();
const jsonld = article
  ? {
      '@context': 'https://schema.org', '@type': 'Article',
      headline: title, datePublished: article.published, dateModified: article.modified ?? article.published,
      author: { '@type': 'Person', name: SITE.operator, url: new URL(u('/about/'), Astro.site).toString() },
      image: [ogImageUrl], publisher: { '@type': 'Person', name: SITE.operator },
    }
  : Astro.url.pathname === u('/')
    ? { '@context': 'https://schema.org', '@type': 'WebSite', name: siteName, url: homeUrl, inLanguage: 'ja' }
    : null;
const fullTitle = title
  ? `${title}｜${SITE.name}`
  : `${SITE.name}｜鳥取県大山町の議案を賛成・反対の両方から`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {(noindex || globalNoindex) && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content={SITE.name} />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@700;800&family=Zen+Kaku+Gothic+New:wght@500;700&display=swap" rel="stylesheet" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <script is:inline>
    try { if (localStorage.getItem('dm.big') === '1') document.documentElement.classList.add('big'); } catch (e) {}
  </script>
</head>
<body>
  <div class="hikoshiki"><a href={u('/about/')}>{SITE.notOfficial}</a></div>
  <header class="site-header">
    <div class="head-row">
      <a class="logo" href={u('/')} aria-label={`${SITE.name}（トップページへ）`}>
        <span class="logo-place">{SITE.place}</span>
        <span class="logo-row"><span class="logo-katte">かってに</span><span class="logo-main">議会だより</span></span>
      </a>
      <button class="tbtn" id="menuBtn" aria-expanded="false" aria-controls="menu">≡ メニュー</button>
    </div>
    <div class="futasuji"></div>
    <p class="fukudai">{SITE.subtitle}</p>
  </header>
  <nav class="menu" id="menu" aria-label="メニュー">
    <ul>
      <li><button type="button" class="js-big">文字を大きくする</button></li>
      <li><a href={u('/teisu/')}>議員定数の特集</a></li>
      <li><a href={u('/about/')}>運営者について</a></li>
      <li><a href={u('/policy/')}>運営方針</a></li>
      <li><a href={u('/rules/')}>お約束と投稿のルール</a></li>
      <li><a href={u('/line/')}>お知らせを受け取る</a></li>
      <li><a href={u('/contact/')}>お問い合わせ</a></li>
    </ul>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="futasuji"></div>
    <div class="inner">
      <p><b>{SITE.name}</b><br />{SITE.place}議会の議案を、採決の前に賛成・反対の両方から解説します。</p>
      <p>このサイトは、{SITE.notOfficial}。運営：{SITE.operator}（{SITE.operatorTitle}）</p>
      <p>このサイトへのお問い合わせは運営者へ（<a href={u('/contact/')}>お問い合わせ</a>／{SITE.contactEmail}）。大山町議会事務局では、このサイトについてはお答えできません。議会の公式な情報は、<a href={SITE.officialGikaiUrl}>大山町議会のページ</a>をご覧ください。</p>
      <nav aria-label="フッター">
        <a href={u('/about/')}>運営者について</a>｜<a href={u('/policy/')}>運営方針</a>｜<a href={u('/rules/')}>お約束と投稿のルール</a>｜<a href={u('/privacy/')}>プライバシー</a>｜<a href={u('/contact/')}>お問い合わせ</a>｜<a href={u('/line/')}>お知らせを受け取る</a>
      </nav>
      <p style="margin-top:12px">© 2026 {SITE.name}</p>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var btn = document.getElementById('menuBtn');
      var menu = document.getElementById('menu');
      btn.addEventListener('click', function () {
        var open = menu.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      function label() {
        var on = document.documentElement.classList.contains('big');
        document.querySelectorAll('.js-big').forEach(function (b) { b.textContent = on ? '文字を標準にする' : '文字を大きくする'; });
      }
      document.querySelectorAll('.js-big').forEach(function (b) {
        b.addEventListener('click', function () {
          var on = document.documentElement.classList.toggle('big');
          try { localStorage.setItem('dm.big', on ? '1' : '0'); } catch (e) {}
          label();
        });
      });
      label();
      document.querySelectorAll('.js-allopen').forEach(function (b) {
        b.addEventListener('click', function () {
          var ds = document.querySelectorAll('details.fold');
          var anyClosed = Array.prototype.some.call(ds, function (d) { return !d.open; });
          ds.forEach(function (d) { d.open = anyClosed; });
          b.textContent = anyClosed ? 'すべて閉じる' : 'すべて開く';
        });
      });
    })();
  </script>
</body>
</html>
